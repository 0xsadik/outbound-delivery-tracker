generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id              Int         @id @default(autoincrement())
  sku             String      @unique
  name            String
  quantityInStock Int         @default(0)
  createdAt       DateTime    @default(now())
  orderItems      OrderItem[]
}

