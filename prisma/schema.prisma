generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              Int         @id @default(autoincrement())
  sku             String      @unique
  name            String
  quantityInStock Int         @default(0)
  createdAt       DateTime    @default(now())
  orderItems      OrderItem[]
}

model Customer {
  id             Int             @id @default(autoincrement())
  name           String
  email          String          @unique
  phone          String?
  address        String?
  createdAt      DateTime        @default(now())
  deliveryOrders DeliveryOrder[]
}

model DeliveryOrder {
  id          Int         @id @default(autoincrement())
  orderNumber String      @unique
  status      String      @default("PENDING")
  customerId  Int?
  customer    Customer?   @relation(fields: [customerId], references: [id])
  createdAt   DateTime    @default(now())
  items       OrderItem[]
}

model OrderItem {
  id              Int           @id @default(autoincrement())
  deliveryOrderId Int
  deliveryOrder   DeliveryOrder @relation(fields: [deliveryOrderId], references: [id])
  productId       Int
  product         Product       @relation(fields: [productId], references: [id])
  qty             Int
}

model DeliveryAgent {
  id          Int        @id @default(autoincrement())
  name        String
  phone       String?
  vehicleInfo String?
  isActive    Boolean    @default(true)
  deliveries  Delivery[]
}

// assigned -> picked_up -> in_transit -> delivered / failed to deliver 

model Delivery {
  id              Int            @id @default(autoincrement())
  deliveryOrderId Int            @unique
  deliveryOrder   DeliveryOrder  @relation(fields: [deliveryOrderId], references: [id])
  agentId         Int?
  agent           DeliveryAgent? @relation(fields: [agentId], references: [id])
  status          String         @default("assigned")
  dispatchedAt    DateTime?
  deliveredAt     DateTime?
}


model StatusHistory {
  id         Int      @id @default(autoincrement())
  entityType String // "DeliveryOrder" | "Delivery"
  entityId   Int
  oldStatus  String?
  newStatus  String
  changedAt  DateTime @default(now())
}
